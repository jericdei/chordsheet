# Postgres connection string
DATABASE_URL=postgresql://chordsheet:chordsheet@localhost:5433/chordsheet

# Shared secret between the web app and the realtime server (min 32 chars).
# Used to sign websocket tokens and to authorize internal publish calls.
REALTIME_SECRET=change-me-to-a-long-random-string-0123456789

# How the web server reaches the realtime server (server-to-server)
REALTIME_INTERNAL_URL=http://localhost:3001

# How browsers reach the realtime websocket
REALTIME_PUBLIC_URL=ws://localhost:3001/ws

REALTIME_PORT=3001
