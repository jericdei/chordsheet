{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "REALTIME_SECRET", "REALTIME_INTERNAL_URL", "REALTIME_PUBLIC_URL", "NODE_ENV"],
  "tasks": {
    "generate": { "cache": false, "outputs": ["src/generated/**"] },
    "build": { "dependsOn": ["^generate", "^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "typecheck": { "dependsOn": ["^generate"] },
    "test": {},
    "dev": { "dependsOn": ["^generate"], "cache": false, "persistent": true }
  }
}
